# ── LiveChat env ──────────────────────────────────────────────────────────────

# PostgreSQL — the chat reuses your Prisma datasource. If your app already has a
# DATABASE_URL, the chat uses the same one; nothing to add here.
DATABASE_URL="postgresql://user:password@localhost:5432/yourdb"

# Where chat photos/files are stored on disk, and the public URL prefix they're
# served under. Defaults shown — both are optional.
#   - In dev (and as a fallback) the included app/uploads/[...path] route serves them.
#   - In production, point nginx (or your CDN) at UPLOADS_DIR served under the prefix.
UPLOADS_DIR="./uploads"
UPLOADS_PUBLIC_PREFIX="/uploads"
